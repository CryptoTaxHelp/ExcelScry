# Normalise text in the repository and check out the platform's native endings,
# except where a specific ending is required for the file to work.
* text=auto

# A CRLF shebang makes a shell script fail with "bad interpreter".
*.sh text eol=lf

# Windows-native scripts and NSIS headers expect CRLF.
*.ps1 text eol=crlf
*.nsh text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Delimited-text fixtures are byte-exact. The generator writes CRLF records and
# a quoted field may hold its own line break; a checkout that turned that
# break into CRLF would hand the reader a different field than the one the
# file was written with, and the test would fail only on a machine whose
# endings differ.
samples/*.csv -text
samples/*.tsv -text

# Binary assets: never normalise, never diff.
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.xlsx binary
*.xlsm binary
